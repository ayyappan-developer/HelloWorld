# ---------------------------------------------------------------
# App keys. Fill these in, then run the app.
# This file is NOT committed to git (see .gitignore).
# ---------------------------------------------------------------

# Supabase -> Project Settings -> API Keys (publishable key, or the legacy anon key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Cloud Console -> APIs & Services -> Credentials
# "Web application" OAuth client. Used by Android and Web.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# "iOS" OAuth client. Only needed if you run on iPhone.
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Secret of the Web OAuth client.
# The app does NOT read this. Paste it in:
# Supabase -> Authentication -> Sign In / Providers -> Google -> Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret
